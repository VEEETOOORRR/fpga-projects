// ─────────────────────────────────────────────────────────────────────────────
// Tang Nano 9K — Constraints completo
// Chip: GW1NR-LV9QN88PC6/I5
// Fonte: esquemático oficial Sipeed (Rev NO.01, 2021-09-22)
//
// AVISOS DE TENSÃO:
//   BANK0/1/2 → 3.3V  → IO_TYPE=LVCMOS33
//   BANK3      → 1.8V  → IO_TYPE=LVCMOS18  (pinos 1–16 e 79–88)
//
// HDMI: usa pares diferenciais TLVDS — não use como GPIO comum.
// SPI Flash: compartilha barramento com o chip interno; cuidado ao usar.
// MicroSD (TF): compartilha pinos com GPIO 36–39 do conector.
// RGB LCD 40 pinos: compartilha muitos pinos com HDMI e GPIO.
// ─────────────────────────────────────────────────────────────────────────────

// ── Clock do sistema ──────────────────────────────────────────────────────────
// 27 MHz, BANK1 (3.3V)
IO_LOC  "clk"   52;
IO_PORT "clk"   IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ── LEDs (x6) ────────────────────────────────────────────────────────────────
// BANK3 (1.8V) — lógica invertida: 0 = acende, 1 = apaga (anodo comum em 1.8V)
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;

// ── Botões (x2) ──────────────────────────────────────────────────────────────
// BANK3 (1.8V) — pull-up 10K; lógica invertida: 0 = pressionado
IO_LOC  "btn1"  3;
IO_PORT "btn1"  IO_TYPE=LVCMOS18 PULL_MODE=UP BANK_VCCIO=1.8;
IO_LOC  "btn2"  4;
IO_PORT "btn2"  IO_TYPE=LVCMOS18 PULL_MODE=UP BANK_VCCIO=1.8;

// ── UART (via BL702 onboard debugger) ────────────────────────────────────────
// BANK0 (3.3V) — conectado ao BL702; tx/rx do ponto de vista do FPGA
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// ── SPI Flash externa (W25Q32) ────────────────────────────────────────────────
// BANK0 (3.3V) — barramento compartilhado com flash interna do GW1NR-9
// Habilite DONE como IO regular no Yosys/nextpnr para acessar estes pinos
IO_LOC  "flash_clk"  59;
IO_PORT "flash_clk"  IO_TYPE=LVCMOS33;
IO_LOC  "flash_cs"   60;
IO_PORT "flash_cs"   IO_TYPE=LVCMOS33;
IO_LOC  "flash_mosi" 61;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33;
IO_LOC  "flash_miso" 62;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33;

// ── MicroSD (TF Card) via SPI ─────────────────────────────────────────────────
// BANK1 (3.3V) — compartilha pinos com GPIO do conector P2
IO_LOC  "tf_sclk" 36;
IO_PORT "tf_sclk" IO_TYPE=LVCMOS33;
IO_LOC  "tf_mosi" 37;
IO_PORT "tf_mosi" IO_TYPE=LVCMOS33;
IO_LOC  "tf_cs"   38;
IO_PORT "tf_cs"   IO_TYPE=LVCMOS33;
IO_LOC  "tf_miso" 39;
IO_PORT "tf_miso" IO_TYPE=LVCMOS33;

// ── HDMI (pares diferenciais TMDS) ───────────────────────────────────────────
// Use primitivas TLVDS_OBUF do Gowin; não conecte como LVCMOS simples.
// Os pinos _p e _n devem ser usados em pares; não misture com GPIO normal.
IO_LOC  "hdmi_clk_p"    69;   // HDMI_CK_P
IO_LOC  "hdmi_clk_n"    68;   // HDMI_CK_N
IO_LOC  "hdmi_d0_p"     71;   // HDMI_D0_P (canal azul)
IO_LOC  "hdmi_d0_n"     70;   // HDMI_D0_N
IO_LOC  "hdmi_d1_p"     73;   // HDMI_D1_P (canal verde)
IO_LOC  "hdmi_d1_n"     72;   // HDMI_D1_N
IO_LOC  "hdmi_d2_p"     75;   // HDMI_D2_P (canal vermelho)
IO_LOC  "hdmi_d2_n"     74;   // HDMI_D2_N

// ── Display SPI (conector 1.14" onboard) ─────────────────────────────────────
// BANK2 (3.3V) — para o display SPI de 1.14" opcional
IO_LOC  "lcd_spi_mosi" 77;
IO_PORT "lcd_spi_mosi" IO_TYPE=LVCMOS33;
IO_LOC  "lcd_spi_clk"  76;
IO_PORT "lcd_spi_clk"  IO_TYPE=LVCMOS33;
IO_LOC  "lcd_spi_rs"   49;   // D/C (data/command)
IO_PORT "lcd_spi_rs"   IO_TYPE=LVCMOS33;
IO_LOC  "lcd_spi_en"   47;   // chip select / enable
IO_PORT "lcd_spi_en"   IO_TYPE=LVCMOS33;
IO_LOC  "lcd_reset"    42;
IO_PORT "lcd_reset"    IO_TYPE=LVCMOS33;
IO_LOC  "lcd_bl"       50;   // backlight (RGB_INIT)
IO_PORT "lcd_bl"       IO_TYPE=LVCMOS33;

// ── GPIO — Conector P1 (lado esquerdo, USB em cima) ──────────────────────────
// BANK1 (3.3V), pinos 25–35 e 40–42
IO_LOC  "p1_25" 25;  IO_PORT "p1_25" IO_TYPE=LVCMOS33;
IO_LOC  "p1_26" 26;  IO_PORT "p1_26" IO_TYPE=LVCMOS33;
IO_LOC  "p1_27" 27;  IO_PORT "p1_27" IO_TYPE=LVCMOS33;
IO_LOC  "p1_28" 28;  IO_PORT "p1_28" IO_TYPE=LVCMOS33;
IO_LOC  "p1_29" 29;  IO_PORT "p1_29" IO_TYPE=LVCMOS33;
IO_LOC  "p1_30" 30;  IO_PORT "p1_30" IO_TYPE=LVCMOS33;
IO_LOC  "p1_31" 31;  IO_PORT "p1_31" IO_TYPE=LVCMOS33;
IO_LOC  "p1_32" 32;  IO_PORT "p1_32" IO_TYPE=LVCMOS33;
IO_LOC  "p1_33" 33;  IO_PORT "p1_33" IO_TYPE=LVCMOS33;
IO_LOC  "p1_34" 34;  IO_PORT "p1_34" IO_TYPE=LVCMOS33;
IO_LOC  "p1_35" 35;  IO_PORT "p1_35" IO_TYPE=LVCMOS33;
IO_LOC  "p1_40" 40;  IO_PORT "p1_40" IO_TYPE=LVCMOS33;
IO_LOC  "p1_41" 41;  IO_PORT "p1_41" IO_TYPE=LVCMOS33;
IO_LOC  "p1_42" 42;  IO_PORT "p1_42" IO_TYPE=LVCMOS33;

// ── GPIO — Conector P2 (lado direito) ────────────────────────────────────────
// BANK0 (3.3V), pinos 51–57 e 63
IO_LOC  "p2_51" 51;  IO_PORT "p2_51" IO_TYPE=LVCMOS33;
IO_LOC  "p2_53" 53;  IO_PORT "p2_53" IO_TYPE=LVCMOS33;
IO_LOC  "p2_54" 54;  IO_PORT "p2_54" IO_TYPE=LVCMOS33;
IO_LOC  "p2_55" 55;  IO_PORT "p2_55" IO_TYPE=LVCMOS33;
IO_LOC  "p2_56" 56;  IO_PORT "p2_56" IO_TYPE=LVCMOS33;
IO_LOC  "p2_57" 57;  IO_PORT "p2_57" IO_TYPE=LVCMOS33;
IO_LOC  "p2_63" 63;  IO_PORT "p2_63" IO_TYPE=LVCMOS33;

// ── GPIO — BANK3 (1.8V) — pinos de uso geral em 1.8V ─────────────────────────
// ATENÇÃO: estes pinos operam a 1.8V — não conecte a sinais de 3.3V
IO_LOC  "p3_79" 79;  IO_PORT "p3_79" IO_TYPE=LVCMOS18 BANK_VCCIO=1.8;
IO_LOC  "p3_80" 80;  IO_PORT "p3_80" IO_TYPE=LVCMOS18 BANK_VCCIO=1.8;
IO_LOC  "p3_81" 81;  IO_PORT "p3_81" IO_TYPE=LVCMOS18 BANK_VCCIO=1.8;
IO_LOC  "p3_82" 82;  IO_PORT "p3_82" IO_TYPE=LVCMOS18 BANK_VCCIO=1.8;
IO_LOC  "p3_83" 83;  IO_PORT "p3_83" IO_TYPE=LVCMOS18 BANK_VCCIO=1.8;
IO_LOC  "p3_84" 84;  IO_PORT "p3_84" IO_TYPE=LVCMOS18 BANK_VCCIO=1.8;
